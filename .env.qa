# ─── Variáveis de ambiente para o stack Docker QA ────────────────────────────
# Copie este arquivo para .env.qa e preencha com as credenciais reais.
# NUNCA commite .env.qa com valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — use as credenciais do projeto de staging/dev
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DATABASE_URL2="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# URL base — dentro do Docker aponta para o service next-app
NEXT_PUBLIC_SITE_URL=http://next-app:3000

# Bypass de autenticação para testes E2E
PLAYWRIGHT_TEST_BYPASS=1
